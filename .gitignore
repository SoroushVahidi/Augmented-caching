__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
output/

# External, non-vendored dependencies (cloned via scripts/setup/*, never
# committed -- e.g. the official CACHEUS source, which has no LICENSE file
# and is therefore executed externally rather than copied into this repo).
/external/

# Dataset artifacts
/data/raw/**
!/data/raw/README.md
!/data/raw/spec_cpu2006/INSTRUCTIONS.md
!/data/raw/wiki2018/INSTRUCTIONS.md
/data/processed/**
!.gitkeep
/data/processed_fair_v1/

