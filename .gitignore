__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
output/

# External, non-vendored dependencies (cloned via scripts/setup/*, never
# committed -- e.g. the official CACHEUS source, which has no LICENSE file
# and is therefore executed externally rather than copied into this repo).
/external/

# Dataset artifacts
/data/raw/**
!/data/raw/README.md
!/data/raw/spec_cpu2006/INSTRUCTIONS.md
!/data/raw/wiki2018/INSTRUCTIONS.md
/data/processed/**
!.gitkeep
/data/processed_fair_v1/

# Large derived artifacts (Wulver runs)
/data/derived/evict_value_v1_wulver*/
/data/derived/evict_value_v1_wulver_array*/
/data/derived/evict_value_v1_fair_v1/
/data/derived/evict_value_v1_cross_family_v1/
/data/derived/supervision_objective_ablation_v1/

# Per-worktree Python virtualenvs
/.venv*/

# Trained model artifacts
/models/*.pkl
/models/supervision_objective_ablation_v1/
/models/supervision_objective_learning_curve_v1/
/models/fair_v1_staging/
/models/cross_family_v1_staging/
/analysis/family_winner_selection/models/*.pkl

# Local reviewer-science generated evidence. Keep analysis/ broadly visible so
# intentionally curated summaries can still be tracked later.
/analysis/distribution_shift_ablation_v1/
/analysis/external_learned_baselines/
/analysis/practical_significance_ablation_v1/
/analysis/reviewer_fairness/fairness_certificate.json
/analysis/reviewer_fairness/fairness_certificate.md
/analysis/reviewer_fairness/policy_comparison_*.csv
/analysis/reviewer_fairness/provenance_*.json
/analysis/reviewer_fairness_cross_family_v1/
/analysis/supervision_objective_ablation_v1/
/analysis/supervision_objective_learning_curve_v1/
/analysis/reuse_tail_horizon_diagnostic_v1*/
/analysis/exact_target_oracle_diagnostic_v1/
/analysis/eviction_loss_target_degeneracy_v1/
/analysis/kbs_comparison_fairness_audit.json
/analysis/kbs_local_current_evidence_synthesis_*/

# Slurm job logs
slurm/logs/
/slurm-*.out
/slurm-*.err

# Local launcher / tmux / scratch logs
/logs/
