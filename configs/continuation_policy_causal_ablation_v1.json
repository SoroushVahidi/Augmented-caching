{
  "protocol_id": "continuation_policy_causal_ablation_v1",
  "status": "PROTOCOL_FROZEN_NO_RESULTS",
  "scientific_question": "Does replacing the fixed LRU continuation used for label construction with the already learned pi1 continuation improve the next learned policy pi2?",
  "conditions": {
    "C0_BASELINE_LRU": {
      "decision_policy": "LRU",
      "label_continuation": "LRU",
      "trained_policy": null,
      "deployment_policy": "LRU",
      "retraining": "none",
      "role": "baseline_context"
    },
    "C1_LRU_CONTINUATION_LEARNED_PI1": {
      "label_continuation": "LRU",
      "train_model": "pi1",
      "deployment_policy": "pi1_recursive",
      "interpretation": "current method: train on Q_H^{pi0} labels where pi0 is LRU"
    },
    "C2_PI1_CONTINUATION_LEARNED_PI2": {
      "label_continuation": "frozen_pi1",
      "train_model": "pi2",
      "deployment_policy": "pi2_recursive",
      "interpretation": "one continuation-update step: train on Q_H^{pi1} labels while keeping pi1 frozen during dataset generation"
    },
    "C1_EXACT_Q_PI0": {
      "label_continuation": "LRU",
      "train_model": null,
      "deployment_policy": "exact_target_policy_induced_by_Q_H^{pi0}",
      "role": "optional_diagnostic_only_not_the_trained_C1_policy"
    }
  },
  "causal_isolation": {
    "only_changed_variable_between_C1_and_C2": "label_continuation_policy: LRU -> frozen_pi1",
    "held_fixed": [
      "leave-one-family-out folds from configs/fair_cross_family_v1/folds",
      "training families",
      "validation family",
      "held-out family",
      "capacities",
      "horizon",
      "candidate set",
      "feature schema",
      "random seed",
      "scalar model family/grid",
      "selection metric",
      "training row budget",
      "evaluation window",
      "preprocessing",
      "downstream miss-ratio metric"
    ],
    "causal_interpretation_valid_if": [
      "C1 and C2 label rows are emitted for the exact same decision_id and candidate_id pairs",
      "pi1 is loaded from a frozen eligible registry record for the same held-out fold",
      "held-out family is excluded from pi1 training and validation",
      "pi1 model artifact hash matches the frozen registry",
      "pi1 is not updated during C2 dataset generation",
