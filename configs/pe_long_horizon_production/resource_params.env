# PE long-horizon production resource parameters.
#
# All values below are resolved from measured evidence (jobs 1287838 and
# 1288047) plus a code-calibrated runtime model documented in
# docs/pe_long_horizon_design_notes.md and the
# LONG_HORIZON_TIMEOUT_DECISION_REPORT session record. No __TBD__ or
# __WAIT_FOR_*__ placeholders remain -- scripts/pe_long_horizon/launch_guard.py
# should now PASS on this file.

# --- measured, from job 1287838 (cap32 preflight, 5 families, COMPLETED 0:0) ---
CAP32_PREFLIGHT_JOB=1287838
CAP32_ELAPSED=00:20:09
CAP32_MAX_RSS_MB=698
CAP32_OUTPUT_BYTES=8133338142
CAP32_FAMILIES_IN_RUN=5
CAP32_CAPACITY=32

# --- measured (PARTIAL), from job 1288047 (cap256 timing probe, cloudphysics only) ---
# State: TIMEOUT at its 90-minute walltime -- NOT a crash, NOT a completed
# scientific run. Preserved as PRELIMINARY_TIMING_ONLY evidence; its partial
# output directory must never be treated as a production cell (see Task 7
# isolation note in docs/pe_long_horizon_design_notes.md).
CAP256_PROBE_JOB=1288047
CAP256_PROBE_STATE=TIMEOUT
CAP256_PROBE_TIMELIMIT=01:30:00
CAP256_PROBE_ELAPSED=01:30:19
CAP256_PROBE_ROWS=15000000
CAP256_PROBE_SHARDS_COMPLETE=30
CAP256_PROBE_THROUGHPUT_ROWS_PER_SEC=2768
CAP256_PROBE_MAX_RSS_MB=613
CAP256_FAMILY_IN_RUN=cloudphysics
CAP256_CAPACITY=256

# --- code-calibrated runtime model (see LONG_HORIZON_TIMEOUT_DECISION_REPORT) ---
# time_per_decision(C, num_horizons, sum_horizons) = num_horizons*K*C^2 + CSTEP*C*sum_horizons
# Solved exactly from the two real data points above (cap32 pooled 5-family
# aggregate; cap256 cloudphysics partial run), cross-validated against
# job 1288047's own completion fraction (31.4% of rows at 31.3% of predicted
# total time).
RUNTIME_MODEL_K=1.3907e-6
RUNTIME_MODEL_CSTEP=8.7911e-8
RUNTIME_MODEL_SAFETY_FACTOR=1.75

# --- expected campaign timing (H={32,64,128}, all 20 tasks, from the model above) ---
EXPECTED_SLOWEST_TASK=wiki2018_cap256
EXPECTED_SLOWEST_TASK_POINT_HOURS=3.848
EXPECTED_SLOWEST_TASK_CONSERVATIVE_HOURS=6.734
EXPECTED_COMPUTE_MAKESPAN_POINT_HOURS=3.848
EXPECTED_COMPUTE_MAKESPAN_CONSERVATIVE_HOURS=6.734
EXPECTED_END_TO_END_CONSERVATIVE_HOURS=8

# --- production resource request (evidence-based, not carried forward from
# the historical 16-CPU/64GB evictv1-dsgen template -- the generator is
# single-threaded; TotalCPU on both 1287838 and 1288047 tracked ~1x Elapsed) ---
CPUS_PER_TASK=2
MEMORY_PER_TASK=4G
ARRAY_CONCURRENCY=10

# --- walltime design: OPTION U (single uniform array), see Task 5 analysis.
# A single --time value applies to all 20 tasks in one array; the smaller
# cap32/64/128 tasks will request more walltime than their evidence-based
# per-capacity ceiling (1h/1.5h/3h) requires, but given ~5800 idle CPUs
# observed on the `general` partition and a trivial total footprint (40
# CPUs, 4GB each), this was judged operationally safer and simpler than
# four capacity-specific arrays with a shared-concurrency coordination risk.
WALLTIME_PER_TASK=10:00:00
WALLTIME_DESIGN=OPTION_U_SINGLE_UNIFORM_ARRAY
# Per-capacity evidence-based ceilings, recorded for reference / for a future
# Option-C split if operational experience ever favors it:
WALLTIME_CEILING_CAP32=01:00:00
WALLTIME_CEILING_CAP64=01:30:00
WALLTIME_CEILING_CAP128=03:00:00
WALLTIME_CEILING_CAP256=10:00:00

# --- production array shape (fixed by the manifest, not resource-dependent) ---
ARRAY_SPEC=0-19
NUM_PRODUCTION_TASKS=20
NUM_LOGICAL_CELLS=60

# --- source provenance (must byte-match at launch time; see Task 3) ---
EXPECTED_SOURCE_SHA=3a04a25094de1e8c57a603e2662b321bcf1d9e88
EXPECTED_SOURCE_BRANCH=main
EXPECTED_GENERATOR_LIB_SHA256=6c07e12eb33010b652a5df004abcb22618e0ce3cb2ec169229d5c8cf1dbb6b59
EXPECTED_GENERATOR_DRIVER_SHA256=7f467561dd26e609a8c7df51d934a3a6598beed5f3cada5f87043cd8a655e43a
